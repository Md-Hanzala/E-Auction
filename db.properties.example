# ==============================================================================
# HASHbid Local Database Configuration Template
# ==============================================================================
# Copy this file to 'src/main/resources/db.properties' (or 'db.properties' in root).
# Configure with your local Oracle Database XE credentials.
#
# IMPORTANT:
# - 'db.properties' is ignored by Git and must NEVER be committed.
# - Keep your actual database passwords private.
# ==============================================================================

db.url=jdbc:oracle:thin:@localhost:1521:XE
db.username=HASHBID
db.password=YOUR_LOCAL_PASSWORD
